# Optional — leave empty to run local-only (LocalStorage + JSON backups).
# Copy to .env.local and fill in from Firebase console → Project settings →
# General → Your apps → (web app) → SDK setup and configuration → Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional — richer search results. Without them, movies/TV search uses
# TVmaze + Wikipedia and games search uses Wikipedia.
# https://www.themoviedb.org/settings/api (API key, v3 auth)
VITE_TMDB_KEY=
# https://rawg.io/apidocs
VITE_RAWG_KEY=
